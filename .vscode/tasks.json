{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Run Spring Boot Backend (Port 8080)",
      "type": "shell",
      "command": "mvn spring-boot:run -o",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "2. Run React Frontend (Port 5173)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": []
    },
    {
      "label": "3. Build React Production Bundle",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": []
    },
    {
      "label": "4. Start Full Application (Backend + Frontend)",
      "type": "shell",
      "command": "bash start.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
